import type { Request, Response } from "express";
import {
    createWorkspaceForUser,
    deleteWorkspaceForUser,
    getWorkspaceByIdForUser,
    listWorkspacesByUser,
    updateWorkspaceForUser,
} from "../services/workspace.services.js";
